POSTGRES_DB=take-home
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o
# Set to false when GITHUB_TOKEN is set — true forces the mock summary for local dev
AI_SUMMARY_FALLBACK_MOCK=true
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Azure production (set on VM — your GitHub username, lowercase)
GHCR_OWNER=your-github-username
# Optional image overrides
# BACKEND_IMAGE=ghcr.io/your-github-username/techkraft-backend:latest
# FRONTEND_IMAGE=ghcr.io/your-github-username/techkraft-frontend:latest
# RUN_SEED_ON_DEPLOY=false

# Email notifications (optional — logs to console when disabled)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# For Gmail, SMTP_FROM must match SMTP_USER (or a verified alias)
SMTP_FROM=your@gmail.com
SMTP_USE_TLS=true
